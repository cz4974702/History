let selected=null,sceneIndex=0,stats={},history=[];
const keys={authority:"王權自主",dependence:"受人影響",alliance:"政治忠誠",agency:"個人能動性",openness:"公開透明",control:"形象掌控",exposure:"爭議曝光",framing:"敘事操控",bias:"選擇性編排",context:"脈絡完整",clarity:"訊息鮮明"};
const $=id=>document.getElementById(id);
document.querySelectorAll("[data-role]").forEach(b=>b.addEventListener("click",()=>{selected=b.dataset.role;document.querySelectorAll("[data-role]").forEach(x=>x.style.outline=x===b?"3px solid #b08a4a":"");$("roleHint").textContent="已選擇："+roles[selected].name+"。你的選擇會累積成一份可能被塑造的形象檔案。";$("begin").disabled=false}));
function begin(){sceneIndex=0;stats={};history=[];$("intro").classList.add("hidden");$("ending").classList.add("hidden");$("play").classList.remove("hidden");render()}
function render(){const r=roles[selected],s=r.scenes[sceneIndex];$("roleName").textContent=r.name;$("step").textContent=`情境 ${sceneIndex+1}／${r.scenes.length}`;$("bar").style.width=`${sceneIndex/r.scenes.length*100}%`;$("theme").textContent=s.theme;$("sceneTitle").textContent=s.title;$("sceneText").textContent=sceneIndex===0?r.intro+" "+s.text:s.text;$("choices").innerHTML="";$("consequence").classList.add("hidden");$("continue").disabled=true;$("continue").textContent=sceneIndex===r.scenes.length-1?"生成形象檔案":"前往下一個情境";s.choices.forEach((c,i)=>{const b=document.createElement("button");b.className="choice";b.innerHTML=`<b>${String.fromCharCode(65+i)}．${c[0]}</b><span>${c[1]}</span>`;b.onclick=()=>choose(i);$("choices").appendChild(b)})}
function choose(i){const s=roles[selected].scenes[sceneIndex],c=s.choices[i];[...$("choices").children].forEach(b=>b.disabled=true);Object.entries(c[4]).forEach(([k,v])=>stats[k]=(stats[k]||0)+v);history.push({scene:s.title,choice:c[0],label:c[2],result:c[3]});$("consequence").classList.remove("hidden");$("consequence").innerHTML=`<strong>這個選擇可能造成的解讀</strong>${c[2]}。${c[3]} ${consequenceText(c[4])}`;$("continue").disabled=false}
function consequenceText(e){const out=[];if(e.authority>=2)out.push("你強化了自主承擔責任的形象");if(e.dependence>=2)out.push("對手更容易把你描繪成受他人影響");if(e.alliance>=2)out.push("支持者更容易把你塑造成忠誠盟友");if(e.framing>=2)out.push("你選擇用鮮明敘事引導公眾理解");if(e.bias>=2)out.push("選擇性呈現可能成為對手反擊的焦點");if(e.context>=2)out.push("你提供脈絡，但可能降低訊息的簡潔性");if(e.exposure>=2)out.push("更多細節曝光，也帶來更多被重新解讀的可能");if(e.control>=2)out.push("你試圖主動控制公眾看到的形象");if(!out.length)out.push("這個選擇的政治效果取決於誰在傳播、如何編排，以及讀者相信什麼");return out.join("；")+"。"}
function finish(){const r=roles[selected];$("play").classList.add("hidden");$("ending").classList.remove("hidden");$("bar").style.width="100%";$("endingTitle").textContent=`${r.name}：形象並非完全由你決定`;const pos=Object.entries(stats).sort((a,b)=>b[1]-a[1]);const top=pos.slice(0,3);$("endingIntro").textContent=`你在三個情境中做出了 ${history.length} 次選擇。這些選擇形成了特定的行動軌跡；不同陣營仍可能用不同方式解釋同一行動。以下是根據你的路線生成的可能形象，而非對歷史人物真實性格的判定。`;$("traits").innerHTML="";top.forEach(([k,v])=>{const el=document.createElement("div");el.className="trait";el.innerHTML=`<span class="muted">形象傾向</span><b>${keys[k]||k}</b><div class="meter"><div style="width:${Math.min(100,Math.max(15,50+v*12))}%"></div></div>`;$("traits").appendChild(el)});
const h=history.map((x,i)=>`${i+1}.「${x.choice}」`).join("；");let n="",a="";
if(selected==="king"){const dep=stats.dependence||0,auth=stats.authority||0,open=stats.openness||0;n=dep>auth?`批評者可能寫道：「國王的決策受到身邊人物左右，難以展現獨立的統治判斷。」支持者則可能說，他是在信任政治盟友。`:auth>dep?`支持者可能寫道：「國王願意承擔決策責任，並維護君主職分。」批評者仍可能從私人通信中挑出片段，質疑這種自主形象。`:`不同陣營可能各取所需：一方把你的行動解讀為謹慎與責任，另一方則將其描繪成迴避或缺乏決斷。`;a="論文摘要指出，《The King’s Cabinet Opened》透過王后形象質疑查理一世的統治能力。你的路線模擬了行動如何被納入這類論述；真正影響形象的，還包括出版者選取哪些材料、如何排列，以及省略哪些背景。"}
else if(selected==="queen"){const al=stats.alliance||0,ag=stats.agency||0;n=al>ag?`支持者可能將你描繪成忠誠、與君主共同承擔危機的政治盟友；批評者則可能把相同的參與描述為越權影響國王。`:ag>al?`你可能被塑造成有自主判斷的政治行動者；對手仍可能把你的自主性描述為對君主權威的威脅。`:`你的形象可能在「忠誠的伴侶」與「影響國王的政治力量」之間擺盪，取決於誰在說故事。`;a="摘要顯示，王后形象能被不同陣營用於不同政治目的。角色行動本身不會自動產生單一形象；支持者與對手會依各自的政治立場，替同一行為賦予不同意義。"}
else if(selected==="pamphleteer"){const fr=stats.framing||0,ct=stats.context||0,bias=stats.bias||0;n=fr+bias>ct?`讀者可能認為你善於揭露國王的弱點；批評者則可能指出，你的標題、選材與排序已經引導了結論。`:ct>fr?`你可能被視為較重視史料脈絡的編輯；但政治支持者可能批評你的呈現不夠有力，難以形成鮮明主張。`:`你可能同時被看成政治溝通者與材料的編排者。讀者不只會閱讀信件，也會受到你安排閱讀順序的影響。`;a="論文摘要將《The King’s Cabinet Opened》視為政治文宣，並指出它把王后形象連結到國王的統治能力。這條路線凸顯：即使不直接捏造材料，選材、標題和編排仍可能塑造讀者的理解。"}
else{const fr=stats.framing||0,ct=stats.context||0,bias=stats.bias||0;n=fr+bias>ct?`支持者可能認為你成功反擊議會派；批評者則可能指出，你也使用了以配偶形象攻擊統治能力的策略。`:ct>fr?`你可能被視為要求讀者檢視證據與脈絡的宣傳者，但鮮明的反擊口號可能因此減弱。`:`你可能被視為務實的反擊者，也可能被批評為把政治責任轉化成人物形象的攻防。`;a="摘要指出，保王派不只藉王后形象宣傳君主權威，也曾透過護國公夫人的行為形象嘲諷克倫威爾的統治能力。這顯示形象政治可以被反向運用，並不只屬於單一陣營。"}
$("narrativeResult").textContent=n;$("analysis").textContent=a;$("endingIntro").textContent+=` 你的行動紀錄：${h}。`}
function advance(){if($("continue").disabled)return;if(sceneIndex<roles[selected].scenes.length-1){sceneIndex++;render()}else finish()}
$("begin").onclick=begin;$("continue").onclick=advance;$("restart").onclick=()=>{$("play").classList.add("hidden");$("intro").classList.remove("hidden")};$("replay").onclick=begin;$("newRole").onclick=()=>{$("ending").classList.add("hidden");$("intro").classList.remove("hidden");selected=null;$("begin").disabled=true;document.querySelectorAll("[data-role]").forEach(x=>x.style.outline="");$("roleHint").textContent="選擇角色後開始。每條路線會出現不同的情境與形象結果。"};
</script></body></html>
